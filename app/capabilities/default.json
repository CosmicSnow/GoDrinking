{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Frontend may listen to backend events, and may open only this repository's GitHub release URLs.",
  "windows": ["main", "player-*"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:event:allow-unlisten",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/CosmicSnow/GoDrinking/releases" },
        { "url": "https://github.com/CosmicSnow/GoDrinking/releases/**" }
      ]
    }
  ]
}
